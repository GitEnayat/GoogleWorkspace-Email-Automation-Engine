{
  "name": "@universal-email/apps-script-adapter",
  "version": "2.0.0",
  "description": "Google Apps Script adapter for Universal Email Automation Engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:ts && npm run build:bundle",
    "build:ts": "tsc",
    "build:bundle": "esbuild dist/index.js --bundle --outfile=dist/EmailEngine.gs --format=iife --global-name=EmailEngine --banner:js=\"/** @OnlyCurrentDoc */\"",
    "dev": "npm run build:ts && npm run build:bundle -- --watch",
    "clean": "rm -rf dist",
    "prebuild:ts": "npm run build -w @universal-email/core"
  },
  "dependencies": {
    "@universal-email/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.86",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
