# ============================================================
# Universal Email Automation Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
# ============================================================

# ── Google Workspace IDs ────────────────────────────────────
# Google Doc ID that contains your email templates
TEMPLATE_DOCUMENT_ID=your_google_doc_id_here

# Google Sheet ID that contains the recipient directory
DIRECTORY_SHEET_ID=your_google_sheet_id_here

# Tab name inside the directory sheet (default: Recipients)
RECIPIENTS_TAB_NAME=Recipients

# Column in the directory sheet that holds email addresses
RECIPIENT_EMAIL_COLUMN=Email

# Comma-separated columns to use as template tags
RECIPIENT_TAG_COLUMNS=FirstName,Team,Department

# Google Sheet ID for the managed links registry (optional)
LINK_REPOSITORY_SHEET_ID=your_links_sheet_id_here
LINK_REPOSITORY_TAB_NAME=Link_Registry

# Google Sheet ID for audit/execution logs (optional)
LOGS_SHEET_ID=your_logs_sheet_id_here
LOGS_TAB_NAME=Execution_Log

# ── Node.js Google Adapter (OAuth2) ─────────────────────────
# Required only when running via node-google-adapter (not Apps Script)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token

# Or use a service account key file path instead of OAuth:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/service-account.json

# ── Microsoft 365 Adapter (Graph API) ───────────────────────
# Required only when using the microsoft-adapter package
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_CLIENT_ID=your_app_client_id
MICROSOFT_CLIENT_SECRET=your_app_client_secret
MICROSOFT_USER_EMAIL=you@yourorg.com

# ── Runtime Defaults ────────────────────────────────────────
# Default execution mode: PROD | TEST | DRY_RUN
DEFAULT_EXECUTION_MODE=DRY_RUN

# Default email action: DRAFT | SEND
DEFAULT_EMAIL_ACTION=DRAFT
